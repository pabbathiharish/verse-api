/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "verse-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-20",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bible-verses-db",
			"database_id": "dab111ed-229d-4e58-b3d0-0f0166d961b2"
		},
		{
			"binding": "QUIZ_DB",
			"database_name": "daily-quiz",
			"database_id": "b36c0ae8-3bf6-4f94-90e0-da439cf86238"
		},
		{
			"binding": "AI_BOOK_CHAPTER_REVIEWS_DB",
			"database_name": "ai_book_chapter_reviews",
			"database_id": "90088f66-d97e-479e-8142-5616ec61967a"
		}
	],
	"vars": {
		"SANTA_FIREBASE_PROJECT_ID": "santabibila",
		"SANTA_FIREBASE_CLIENT_EMAIL": "firebase-adminsdk-1hgxh@santabibila.iam.gserviceaccount.com",
		"PORTUGUESE_FIREBASE_PROJECT_ID": "portuguese-bibil-1581151330423",
		"PORTUGUESE_FIREBASE_CLIENT_EMAIL": "firebase-adminsdk-24ool@portuguese-bibil-1581151330423.iam.gserviceaccount.com",
		"ANDROID_APPS_FIREBASE_PROJECT_ID": "bibleapps-b6fd7",
		"ANDROID_APPS_FIREBASE_CLIENT_EMAIL": "firebase-adminsdk-hvnnl@bibleapps-b6fd7.iam.gserviceaccount.com",
		"ANDROID_APPS1_FIREBASE_PROJECT_ID": "bibleapps1-6f602",
		"ANDROID_APPS1_FIREBASE_CLIENT_EMAIL": "firebase-adminsdk-dp4kx@bibleapps1-6f602.iam.gserviceaccount.com",
		"OPENAI_MODEL": "gpt-5.4-mini"
	},
	"triggers": {
		// Union of morning + noon + evening timezone buckets. Some UTC times
		// are shared between pushes (see comments). Keep in sync with
		// src/utils/morningCronSchedule.ts, src/utils/noonCronSchedule.ts and
		// src/utils/eveningCronSchedule.ts.
		"crons": [

			// Morning — local ~08:00 (morningCronSchedule.ts)

			"0 0 * * *",  // UTC+8   morning: tl, fil
			"0 1 * * *",  // UTC+7   morning: id, vi
			"30 2 * * *", // UTC+5:30 morning: Indian subcontinent
			"0 6 * * *",  // UTC+2   morning: zu, st, af, ro, el, fi
			"0 7 * * *",  // UTC+1   morning: es, fr, de, it
			"0 8 * * *",  // UTC+0   morning: en, eo

			// Noon — local ~12:00 (noonCronSchedule.ts)

			"0 3 * * *",  // UTC+9   noon: ko
			"0 4 * * *",  // UTC+8   noon: tl, fil
			"30 6 * * *", // UTC+5:30 noon: Indian subcontinent
			"0 9 * * *",  // UTC+3   noon: ru, ar, sw
			"0 10 * * *", // UTC+2   noon: zu, st, af, ro, el, fi
			"0 15 * * *", // UTC-3   noon: pt (Brazil)

			// Evening — local ~20:00 (eveningCronSchedule.ts)

			"0 13 * * *", // UTC+7   evening: id, vi
			"30 14 * * *",// UTC+5:30 evening: Indian subcontinent
			"0 17 * * *", // UTC+3   evening: ru, ar, sw
			"0 18 * * *", // UTC+2   evening: zu, st, af, ro, el, fi
			"0 19 * * *", // UTC+1   evening: es, fr, de, it
			"0 20 * * *", // UTC+0   evening: en, eo

			// Shared UTC times (fire more than one push/bucket)

			"0 5 * * *",  // morning: ru, ar, sw        |  noon: id, vi
			"0 11 * * *", // morning: pt | evening: ko  |  noon: es, fr, de, it
			"0 12 * * *", // evening: tl, fil           |  noon: en, eo
			"0 23 * * *"  // morning: ko                |  evening: pt (Brazil)
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}